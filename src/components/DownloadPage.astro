---
import LanguageLink from './LanguageLink.astro';
import { href, t, tf, tList, type Locale } from '../i18n';
import { allReleasesUrl, changelogLink, downloadCards, formatDate, formatSize, linuxArchsKey, linuxArm, release } from '../lib/release';
import { rich } from '../lib/rich';

interface Props { locale: Locale }

const { locale } = Astro.props;
const a = release.assets;
const p = (key: string) => t(locale, `downloadPage.${key}`);
const version = release.version;
const archs = { archs: t(locale, linuxArchsKey) };
const changelog = changelogLink(locale);
// The repository documents are published in English only; Czech pages link to the English Privacy page.
const links = { privacy: { href: href('en', 'privacy/'), hreflang: changelog.hreflang } };
// The Help is translated, so its links stay in the visitor's language.
const helpLinks = {
  help: { href: href(locale, 'help/') },
  recovery: { href: href(locale, 'help/#forgotten-password') },
  backup: { href: href(locale, 'help/#backup') },
  import: { href: href(locale, 'help/#import') },
};

// The commands name the real files of this release, so they can be pasted as they are.
const linuxInstall = [
  { label: t(locale, 'download.linux.appimage'), command: `chmod +x ${a.appimage.name} && ./${a.appimage.name}`, note: p('install.linux.fuse') },
  { label: t(locale, 'download.linux.deb'), command: `sudo apt install ./${a.deb.name}` },
  { label: 'Fedora', command: `sudo dnf install ./${a.rpm.name}` },
];
const linuxArmNote = linuxArm && tf(locale, 'downloadPage.install.linux.armFiles', { appimage: linuxArm.appimage.name, deb: linuxArm.deb.name, rpm: linuxArm.rpm.name });
---
<section class="block">
  <div class="wrap">
    <div class="page-head">
      <h1>{tf(locale, 'downloadPage.title', { version })}</h1>
      <p class="page-meta">{tf(locale, 'downloadPage.released', { date: formatDate(locale) })} · <LanguageLink locale={locale} href={changelog.href} hreflang="en">{t(locale, 'download.changes')}</LanguageLink> · <LanguageLink locale={locale} href={allReleasesUrl} hreflang="en">{p('allReleases')}</LanguageLink></p>
    </div>
    <p class="download-intro">{p('intro')}</p>
    <h2 class="sr-only">{p('filesTitle')}</h2>
    <div class="dl-grid">
      {downloadCards.map((c) => (
        <div class="card dl" id={c.id} data-os={c.id}>
          <div class="dl__os"><h3>{c.os}</h3><span class="badge" data-current hidden>{p('recommended')}</span></div>
          <p class="dl__warning">{tf(locale, `download.${c.id}.note`, archs)} {c.id !== 'linux' && <a href={`#install-${c.id}`} class="link">{p('installLink')}</a>}</p>
          <div class="dl__files">
            {c.files.map(([file, key]) => (
              <a href={file.url}><span>{t(locale, key)}</span><span>{formatSize(file.bytes, locale)}</span></a>
            ))}
          </div>
          {c.id === 'mac' && <p class="dl__note" set:html={rich(p('macHint'))} />}
        </div>
      ))}
    </div>
  </div>
</section>

<section class="block" id="install">
  <div class="wrap">
    <div class="block-head">
      <h2 class="title">{p('install.title')}</h2>
      <p>{p('install.unsigned')}</p>
    </div>
    <div class="install">
      <div class="card card--flat install__card" id="install-mac">
        <h3>macOS</h3>
        <ol class="steps">
          <li><span set:html={rich(p('install.mac.open'))} /></li>
          <li><span set:html={rich(p('install.mac.launch'))} /></li>
        </ol>
      </div>
      <div class="card card--flat install__card" id="install-win">
        <h3>Windows</h3>
        <ol class="steps">
          <li><span set:html={rich(p('install.win.keep'))} /></li>
          <li><span set:html={rich(p('install.win.run'))} /></li>
        </ol>
      </div>
      <div class="card card--flat install__card">
        <h3>Linux</h3>
        <p class="install__alt install__alt--first">{tf(locale, 'downloadPage.install.linux.arch', archs)}</p>
        <div class="cmds">
          {linuxInstall.map((c) => (
            <div>
              <b>{c.label}</b>
              <pre class="code"><code>{c.command}</code></pre>
              {c.note && <p class="steps__note" set:html={rich(c.note)} />}
            </div>
          ))}
        </div>
        {linuxArmNote && <p class="steps__note" set:html={rich(linuxArmNote)} />}
      </div>
    </div>
  </div>
</section>

<section class="block">
  <div class="wrap pair">
    <div class="pair__col" id="first-run">
      <h2 class="title title--sm">{p('first.title')}</h2>
      <p>{p('first.intro')}</p>
      <ol class="steps">
        {tList(locale, 'downloadPage.first.steps').map((s) => <li><span set:html={rich(s)} /></li>)}
      </ol>
      <p>{p('first.outro')}</p>
      <p set:html={rich(p('first.help'), helpLinks)} />
    </div>
    <div class="pair__col" id="updating">
      <h2 class="title title--sm">{p('updating.title')}</h2>
      <p set:html={rich(p('updating.text'), links)} />
    </div>
  </div>
</section>

<section class="block" id="requirements">
  <div class="wrap">
    <div class="block-head">
      <h2 class="title">{p('requirements.title')}</h2>
    </div>
    <div class="dl-grid">
      {downloadCards.map((c) => (
        <div class="card card--flat req">
          <h3>{c.os}</h3>
          <p set:html={rich(tf(locale, `downloadPage.requirements.${c.id}`, archs))} />
        </div>
      ))}
    </div>
  </div>
</section>
