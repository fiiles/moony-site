---
import { href, t, type Locale } from '../i18n';
import { repoUrl } from '../config';

interface Props { locale: Locale }

const { locale } = Astro.props;
// The repository documents are published in English only; Czech pages link to the English ones.
const docs = (path: string) => ({ href: href('en', path), hreflang: locale === 'cs' ? 'en' : undefined });
const product = [
  { label: t(locale, 'footer.download'), href: href(locale, 'download/') },
  { label: t(locale, 'footer.changelog'), ...docs('changelog/') },
];
const trust = [
  { label: t(locale, 'footer.privacy'), ...docs('privacy/') },
  { label: t(locale, 'footer.security'), ...docs('security/') },
  { label: t(locale, 'footer.licence'), href: `${repoUrl}/blob/main/LICENSE` },
  { label: t(locale, 'footer.sitePrivacy'), href: href(locale, 'site-privacy/') },
];
const community = [
  { label: t(locale, 'footer.github'), href: repoUrl },
  { label: t(locale, 'footer.discussions'), href: `${repoUrl}/discussions` },
  { label: t(locale, 'footer.presets'), href: `${repoUrl}/blob/main/CONTRIBUTING.md#adding-a-bank-preset` },
  { label: t(locale, 'footer.translate'), href: `${repoUrl}/blob/main/CONTRIBUTING.md` },
];
const columns = [
  { title: t(locale, 'footer.product'), links: product },
  { title: t(locale, 'footer.trust'), links: trust },
  { title: t(locale, 'footer.community'), links: community },
];
---
<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <div class="brand"><span class="moon"></span><b>{t(locale, 'site.name')}</b></div>
        <p class="foot-blurb">{t(locale, 'footer.blurb')}</p>
      </div>
      {columns.map((c) => (
        <div>
          <h4>{c.title}</h4>
          <ul>{c.links.map((l) => <li><a href={l.href} hreflang={l.hreflang}>{l.label}</a></li>)}</ul>
        </div>
      ))}
    </div>
    <div class="foot-note">
      <span>{t(locale, 'footer.disclaimer')}</span>
      <span>{t(locale, 'footer.copyright')} · {t(locale, 'footer.nocookies')}</span>
    </div>
  </div>
</footer>
