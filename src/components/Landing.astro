---
import Hero from './landing/Hero.astro';
import Feature from './landing/Feature.astro';
import Tracks from './landing/Tracks.astro';
import Trust from './landing/Trust.astro';
import GettingStarted from './landing/GettingStarted.astro';
import DownloadTeaser from './landing/DownloadTeaser.astro';
import Faq from './landing/Faq.astro';
import AssistantPreview from './landing/AssistantPreview.astro';
import LanguageLink from './LanguageLink.astro';
import { t, tList, type Locale } from '../i18n';
import { repoUrl } from '../config';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<Hero locale={locale} />
<section class="overview block" id="overview">
  <div class="wrap">
    <div class="overview__intro">
      <h2 class="title">{t(locale, 'features.overview.title')}</h2>
      <p>{t(locale, 'features.overview.text')}</p>
    </div>
    <ul class="overview__benefits">
      {tList(locale, 'features.overview.bullets').map(b => <li><svg class="ic" aria-hidden="true"><use href="#i-check"/></svg>{b}</li>)}
    </ul>
  </div>
</section>
<Feature locale={locale} k="features.import" id="import" shot="account-detail" flip>
  <details class="feature-details">
    <summary>{t(locale, 'features.import.formatsTitle')}</summary>
    <p>{t(locale, 'features.import.formats')}</p>
  </details>
</Feature>
<Feature locale={locale} k="features.investments" id="investments" shot="stocks-analysis" />
<Feature locale={locale} k="features.otherInstruments" id="other-instruments" shot="loans" flip />
<GettingStarted locale={locale} />
<Tracks locale={locale} />
<Trust locale={locale} />
<AssistantPreview locale={locale} />
<aside class="maker">
  <div class="wrap maker__inner">
    <div><h2>{t(locale, 'about.title')}</h2><p>{t(locale, 'about.text')}</p><LanguageLink locale={locale} href={`${repoUrl}/discussions`} hreflang="en">{t(locale, 'about.link')}</LanguageLink></div>
  </div>
</aside>
<DownloadTeaser locale={locale} />
<Faq locale={locale} />
