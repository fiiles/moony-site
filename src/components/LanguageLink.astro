---
import type { Locale } from '../i18n';
interface Props {
  locale: Locale;
  href: string;
  hreflang?: string;
  class?: string;
}
const { locale, href, hreflang, class: className = 'link' } = Astro.props;
---
<a href={href} hreflang={hreflang} class={className}><slot />{locale === 'cs' && hreflang === 'en' && <>{' '}<span class="link-language" lang="en">(EN)</span></>}</a>
