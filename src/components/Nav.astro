---
import LanguageLink from './LanguageLink.astro';
import { href, locales, localeInfo, t, type Locale } from '../i18n';
import { repoUrl } from '../config';

interface Props {
  locale: Locale;
  /** Current page path without the locale prefix; the language switch points at the same page in the other locale. */
  path: string;
  /** The current page exists in English only; the other languages then lead to their home page instead of a missing page. */
  englishOnly?: boolean;
}

const { locale, path, englishOnly = false } = Astro.props;
const home = href(locale, '');
const choices = locales.map((l) => ({ ...localeInfo(l), href: href(l, englishOnly && l !== 'en' ? '' : path) }));
const current = localeInfo(locale);
---
<header class="site-nav">
  <div class="wrap">
    <a class="brand" href={home} aria-label={t(locale, 'nav.home')}><span class="moon"></span><b>{t(locale, 'site.name')}</b></a>
    <nav class="nav-links" aria-label={t(locale, 'nav.label')}>
      <a href={home + '#overview'}>{t(locale, 'nav.features')}</a>
      <a href={home + '#start'}>{t(locale, 'nav.tracks')}</a>
      <a href={home + '#privacy'}>{t(locale, 'nav.privacy')}</a>
      <a href={home + '#faq'}>{t(locale, 'nav.faq')}</a>
    </nav>
    <div class="nav-right">
      <details class="lang-menu">
        <summary title={t(locale, 'nav.language')} aria-label={`${t(locale, 'nav.language')}: ${current.native}`}>
          <svg class="ic" aria-hidden="true"><use href="#i-globe"/></svg>
          <span class="lang-menu__name">{current.native}</span><span class="lang-menu__code">{current.code.toUpperCase()}</span>
          <svg class="ic lang-menu__chevron" aria-hidden="true"><use href="#i-chevron"/></svg>
        </summary>
        <ul>
          {choices.map((c) => (
            <li><a href={c.href} lang={c.htmlLang} hreflang={c.htmlLang} data-lang-choice={c.code} aria-current={c.code === locale ? 'true' : undefined}>{c.native}</a></li>
          ))}
        </ul>
      </details>
      <LanguageLink locale={locale} class="btn btn--ghost" href={repoUrl} hreflang="en"><svg class="ic" aria-hidden="true"><use href="#i-github"/></svg>{t(locale, 'nav.github')}</LanguageLink>
      <a class="btn btn--primary" href={href(locale, 'download/')}><svg class="ic" aria-hidden="true"><use href="#i-download"/></svg>{t(locale, 'nav.download')}</a>
    </div>
  </div>
</header>
