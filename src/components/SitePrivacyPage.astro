---
import { href, t, type Locale } from '../i18n';
import { rich } from '../lib/rich';

interface Props { locale: Locale }

const { locale } = Astro.props;
// The app's Privacy page is published in English only; Czech pages link to the English one.
const links = { privacy: { href: href('en', 'privacy/'), hreflang: locale === 'cs' ? 'en' : undefined } };
const items = ['cookies', 'origin', 'hosting', 'downloads', 'operator'];
---
<section class="block">
  <div class="wrap prose">
    <h1>{t(locale, 'sitePrivacy.title')}</h1>
    <p class="lead" set:html={rich(t(locale, 'sitePrivacy.intro'), links)} />
    {items.map((id) => (
      <>
        <h2>{t(locale, `sitePrivacy.items.${id}.title`)}</h2>
        <p set:html={rich(t(locale, `sitePrivacy.items.${id}.text`))} />
      </>
    ))}
  </div>
</section>
