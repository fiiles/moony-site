---
import { enOnlyLink, t, tf, type Locale } from '../i18n';
import { rich } from '../lib/rich';
import { supportEmail } from '../config';

interface Props { locale: Locale }

const { locale } = Astro.props;
// The app's Privacy page is published in English only; pages in other languages link to the English one.
const links = { privacy: enOnlyLink(locale, 'privacy/') };
// The operator text names the contact address; it is filled in from src/config.ts and never typed in a dictionary.
const operatorLinks = { email: { href: `mailto:${supportEmail}` } };
const text = (id: string) => (id === 'operator' ? rich(tf(locale, `sitePrivacy.items.${id}.text`, { email: supportEmail }), operatorLinks) : rich(t(locale, `sitePrivacy.items.${id}.text`)));
const items = ['cookies', 'origin', 'language', 'hosting', 'downloads', 'operator'];
---
<section class="block">
  <div class="wrap prose">
    <h1>{t(locale, 'sitePrivacy.title')}</h1>
    <p class="lead" set:html={rich(t(locale, 'sitePrivacy.intro'), links)} />
    {items.map((id) => (
      <>
        <h2>{t(locale, `sitePrivacy.items.${id}.title`)}</h2>
        <p set:html={text(id)} />
      </>
    ))}
  </div>
</section>
