---
import { enOnlyLink, href, t, tf, type Locale } from '../i18n';
import { rich, type RichLink } from '../lib/rich';
import { repoUrl, supportEmail, syncIssuesUrl } from '../config';

interface Props { locale: Locale }

const { locale } = Astro.props;
// Link targets used in the support.* strings. The Security page and GitHub are English only; strings in other languages say so in the link text.
const links: Record<string, RichLink> = {
  email: { href: `mailto:${supportEmail}` },
  help: { href: href(locale, 'help/') },
  recovery: { href: href(locale, 'help/#forgotten-password') },
  backup: { href: href(locale, 'help/#backup') },
  import: { href: href(locale, 'help/#import') },
  sync: { href: href(locale, 'help/#sync') },
  syncIssues: { href: syncIssuesUrl, hreflang: 'en' },
  issues: { href: `${repoUrl}/issues/new/choose`, hreflang: 'en' },
  security: enOnlyLink(locale, 'security/'),
  discussions: { href: `${repoUrl}/discussions`, hreflang: 'en' },
};
const items = ['email', 'help', 'bug', 'security', 'ideas'];
// The address is filled in from src/config.ts; it is never typed in a dictionary.
const text = (id: string) => rich(tf(locale, `support.items.${id}.text`, { email: supportEmail }), links);
---
<section class="block">
  <div class="wrap prose">
    <h1>{t(locale, 'support.title')}</h1>
    <p class="lead">{t(locale, 'support.intro')}</p>
    {items.map((id) => (
      <>
        <h2>{t(locale, `support.items.${id}.title`)}</h2>
        <p set:html={text(id)} />
      </>
    ))}
  </div>
</section>
