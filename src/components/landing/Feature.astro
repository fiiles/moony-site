---
import Shot from './Shot.astro';
import { t, tList, type Locale } from '../../i18n';
interface Props {
  locale: Locale;
  /** Dictionary prefix: title, text, bullets and alt. */
  k: string;
  id: string;
  shot: string;
  flip?: boolean;
}
const { locale, k, id, shot, flip = false } = Astro.props;
const p = (key: string) => t(locale, `${k}.${key}`);
---
<section class:list={['feature', { 'feature--flip': flip }]} id={id}>
  <div class="wrap feature__grid">
    <div class="feature__copy">
      <h2 class="title">{p('title')}</h2>
      <div class="feature__body">
        <p>{p('text')}</p>
        <ul class="ticks">
          {tList(locale, `${k}.bullets`).map(b => <li><svg class="ic" aria-hidden="true"><use href="#i-check"/></svg>{b}</li>)}
        </ul>
        <slot />
      </div>
    </div>
    <figure class="shot feature__media"><Shot locale={locale} name={shot} alt={p('alt')} /></figure>
  </div>
</section>
