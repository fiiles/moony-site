---
import release from '../../data/release.json';
import { href, t, tf, type Locale } from '../../i18n';
import Shot from './Shot.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const facts = ['noAccount', 'local', 'offline'];
---
<section class="hero-section">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <div class="eyebrow">{t(locale, 'hero.eyebrow')}</div>
      <h1>{t(locale, 'site.tagline')}</h1>
      <p class="lead">{t(locale, 'hero.lead')}</p>
      <div class="cta">
        <a class="btn btn--primary btn--lg" href={href(locale, 'download/')} id="dl-primary" data-platform-link data-mac={t(locale, 'hero.ctaMac')} data-win={t(locale, 'hero.ctaWin')} data-linux={t(locale, 'hero.ctaLinux')}><svg class="ic" aria-hidden="true"><use href="#i-download"/></svg><span>{t(locale, 'hero.ctaDefault')}</span></a>
        <a class="hero-preview link" href="#overview">{t(locale, 'hero.ctaPreview')} <span aria-hidden="true">↓</span></a>
      </div>
      <p class="cta-note">{t(locale, 'hero.noteStrong')} · {tf(locale, 'hero.noteRest', { version: release.version })}</p>
      <ul class="facts">
        {facts.map(f => <li><svg class="ic" aria-hidden="true"><use href="#i-check"/></svg>{t(locale, `hero.facts.${f}`)}</li>)}
      </ul>
    </div>
    <figure class="hero-visual">
      <div class="frame"><Shot locale={locale} name="dashboard" alt={t(locale, 'hero.alt')} eager layout="hero" /></div>
      <figcaption class="frame-caption">{t(locale, 'hero.caption')}</figcaption>
    </figure>
  </div>
</section>
