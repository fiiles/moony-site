---
import release from '../../data/release.json';
import { asset, href, t, tf, type Locale } from '../../i18n';
import { repoUrl } from '../../config';
import Shot from './Shot.astro';

interface Props { locale: Locale }

const { locale } = Astro.props;
const facts = ['noAccount', 'noCloud', 'noTelemetry', 'encrypted', 'offline', 'languages'];
---
<section class="hero-section">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <div class="eyebrow">{t(locale, 'hero.eyebrow')}</div>
      <h1>{t(locale, 'site.tagline')}</h1>
      <p class="lead">{t(locale, 'hero.lead')}</p>
      <div class="cta">
        <a
          class="btn btn--primary btn--lg"
          href={href(locale, 'download/')}
          id="dl-primary"
          data-mac={t(locale, 'hero.ctaMac')}
          data-win={t(locale, 'hero.ctaWin')}
          data-linux={t(locale, 'hero.ctaLinux')}
        ><svg class="ic" aria-hidden="true"><use href="#i-download"/></svg><span>{t(locale, 'hero.ctaDefault')}</span></a>
        <a class="btn btn--lg" href={repoUrl}><svg class="ic" aria-hidden="true"><use href="#i-github"/></svg>{t(locale, 'hero.ctaSource')}</a>
      </div>
      {/* At 1.0.0 remove hero.beta from both dictionaries and its text and separator on the next line. */}
      <p class="cta-note"><b>{t(locale, 'hero.noteStrong')}</b> {tf(locale, 'hero.noteRest', { version: release.version })} · {t(locale, 'hero.beta')}</p>
      <div class="facts">
        {facts.map((f) => <span><svg class="ic" aria-hidden="true"><use href="#i-check"/></svg>{t(locale, `hero.facts.${f}`)}</span>)}
      </div>
    </div>
    <div class="hero-visual">
      <div class="frame"><Shot locale={locale} name="dashboard" alt={t(locale, 'hero.alt')} eager /></div>
      <p class="frame-caption">{t(locale, 'hero.caption')}</p>
    </div>
  </div>
</section>

{/* The platform detection lives in a file of its own so the Content-Security-Policy can stay script-src 'self'. */}
<script is:inline src={asset('js/os.js')} defer></script>
