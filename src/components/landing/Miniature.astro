---
import { t, tList, type Locale } from '../../i18n';

interface Props { locale: Locale }

const { locale } = Astro.props;
const m = (key: string) => t(locale, `miniature.${key}`);

// The four periods: data-p value on the toggle button, the key of its copy in the dictionary, and its button label.
const periods = [
  { p: '30', key: 'p30', label: m('periods.p30') },
  { p: '90', key: 'p90', label: m('periods.p90') },
  { p: '365', key: 'p365', label: m('periods.p365') },
  { p: 'all', key: 'all', label: m('periods.all') },
];
// Everything the chart script prints is translated here and handed over as JSON; the numeric series stay in the script.
const copy = Object.fromEntries(periods.map(({ p, key }) => [p, {
  delta: m(`${key}.delta`),
  note: m(`${key}.note`),
  insight: m(`${key}.insight`),
  labels: tList(locale, `miniature.${key}.labels`),
}]));
const first = copy['30'];

const nav = [
  { eyebrow: m('nav.money'), items: [['bank', 'i-bank'], ['budgets', 'i-pig'], ['cashflow', 'i-chart']] },
  { eyebrow: m('nav.investments'), items: [['stocks', 'i-trend'], ['crypto', 'i-coin'], ['realEstate', 'i-home']] },
  { eyebrow: m('nav.liabilities'), items: [['loans', 'i-card'], ['insurance', 'i-shield']] },
];
const stats = [
  { key: 'assets', dot: '' },
  { key: 'liabilities', dot: 'var(--s3)' },
  { key: 'cash', dot: 'var(--s2)' },
];
---
<div class="hero-visual">
  <div class="frame" role="group" aria-label={m('label')}>
    <div class="mini">
      <aside class="mini-side" aria-hidden="true">
        <div class="brand"><span class="moon moon--sm"></span><div><b>{t(locale, 'site.name')}</b><small>{m('brandSub')}</small></div></div>
        <div class="mini-group"><div class="mini-nav"><span class="is-active"><svg class="ic" aria-hidden="true"><use href="#i-grid"/></svg>{m('nav.overview')}</span></div></div>
        {nav.map((g) => (
          <div class="mini-group">
            <div class="eyebrow">{g.eyebrow}</div>
            <div class="mini-nav">{g.items.map(([name, icon]) => <span><svg class="ic" aria-hidden="true"><use href={`#${icon}`}/></svg>{m(`nav.${name}`)}</span>)}</div>
          </div>
        ))}
        <div class="foot"><span class="avatar">AM</span>Alex Meyer</div>
      </aside>
      <div class="mini-page">
        <div class="mini-top"><span><b>{m('nav.overview')}</b> &nbsp;/&nbsp; {m('crumb')}</span><span class="status">{m('status')}</span></div>
        <div class="mini-head">
          <div><div class="eyebrow">{m('eyebrow')}</div><p class="mini-title">{m('greeting')}</p><p class="mini-asof">{m('asOf')}</p></div>
          <div class="seg" id="period" role="group" aria-label={m('periodLabel')}>
            {periods.map(({ p, label }, i) => <button type="button" class:list={['seg__btn', { 'is-active': i === 0 }]} data-p={p} aria-pressed={i === 0 ? 'true' : 'false'}>{label}</button>)}
          </div>
        </div>
        <section class="card mini-hero">
          <div class="hero__head">
            <div>
              <div class="hero__label">{m('netWorth')}</div>
              <span class="hero__value num">{m('netWorthValue')}</span>
              <div class="hero__delta gain" id="nw-delta">{first.delta}<span id="nw-note">{first.note}</span></div>
            </div>
            <p class="insight" id="nw-insight">{first.insight}</p>
          </div>
          <div class="chart chart--worth" id="chart" data-periods={JSON.stringify(copy)}></div>
          <div class="chart__axis" id="axis">{first.labels.map((l) => <span>{l}</span>)}</div>
        </section>
        <div class="mini-stats">
          {stats.map((s) => (
            <div class="stat">
              <div class="stat__label">{m(`${s.key}.label`)} <span class="dot" style={s.dot ? `background:${s.dot}` : undefined}></span></div>
              <span class="stat__value num">{m(`${s.key}.value`)}</span>
              <span class="stat__note">{m(`${s.key}.note`)}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
  <p class="frame-caption">{m('caption')}</p>
</div>

<script is:inline>
  (function () {
    var chart = document.getElementById('chart');
    var axis = document.getElementById('axis');
    var toggle = document.getElementById('period');
    if (!chart || !axis || !toggle) return;
    var text = JSON.parse(chart.dataset.periods);

    // Deterministic sample series (no Math.random, so the page is reproducible)
    function series(n, start, drift, wobble, seed) {
      var out = [], v = start, s = seed;
      for (var i = 0; i < n; i++) {
        s = (s * 9301 + 49297) % 233280;
        var r = s / 233280 - 0.5;
        v = v * (1 + drift) + r * wobble;
        out.push(v);
      }
      return out;
    }
    // Only numbers live here; every word (notes, insights, axis labels) comes from `text`.
    var DATA = {
      30:  { pts: series(30, 179290, 0.00095, 1900, 7) },
      90:  { pts: series(90, 171800, 0.00080, 2400, 3) },
      365: { pts: series(365, 156900, 0.00045, 2600, 11) },
      all: { pts: series(720, 101200, 0.00085, 2800, 5) }
    };

    var NS = 'http://www.w3.org/2000/svg';
    function el(n, a) { var e = document.createElementNS(NS, n); for (var k in a) e.setAttribute(k, a[k]); return e; }
    function draw(key) {
      var d = DATA[key], words = text[key];
      var w = chart.clientWidth || 560, h = chart.clientHeight || 128;
      var pts = d.pts, n = pts.length, min = Math.min.apply(null, pts), max = Math.max.apply(null, pts);
      var pad = (max - min) * 0.15 || 1; min -= pad; max += pad * 0.4;
      var x = function (i) { return (i / (n - 1)) * w; };
      var y = function (v) { return h - ((v - min) / (max - min)) * h; };
      var svg = el('svg', { viewBox: '0 0 ' + w + ' ' + h, width: w, height: h, 'aria-hidden': 'true' });
      var grad = el('linearGradient', { id: 'ga', x1: 0, y1: 0, x2: 0, y2: 1 });
      grad.appendChild(el('stop', { offset: '0', 'stop-color': 'var(--chart-area)', 'stop-opacity': 1 }));
      grad.appendChild(el('stop', { offset: '1', 'stop-color': 'var(--chart-area)', 'stop-opacity': 0 }));
      var defs = el('defs', {}); defs.appendChild(grad); svg.appendChild(defs);
      for (var g = 1; g <= 3; g++) svg.appendChild(el('line', { x1: 0, x2: w, y1: (h / 4) * g, y2: (h / 4) * g, stroke: 'var(--chart-grid)', 'stroke-width': 1 }));
      var path = '';
      for (var i = 0; i < n; i++) path += (i ? ' L' : 'M') + x(i).toFixed(1) + ' ' + y(pts[i]).toFixed(1);
      svg.appendChild(el('path', { d: path + ' L' + w + ' ' + h + ' L0 ' + h + ' Z', fill: 'url(#ga)' }));
      svg.appendChild(el('path', { d: path, fill: 'none', stroke: 'var(--chart-line)', 'stroke-width': 2.25, 'stroke-linejoin': 'round' }));
      svg.appendChild(el('circle', { cx: x(n - 1), cy: y(pts[n - 1]), r: 4, fill: 'var(--paper)', stroke: 'var(--chart-line)', 'stroke-width': 2.25 }));
      chart.replaceChildren(svg);
      axis.replaceChildren.apply(axis, words.labels.map(function (l) { var s = document.createElement('span'); s.textContent = l; return s; }));
      document.getElementById('nw-delta').firstChild.textContent = words.delta;
      document.getElementById('nw-note').textContent = words.note;
      document.getElementById('nw-insight').textContent = words.insight;
    }

    var current = '30';
    toggle.addEventListener('click', function (e) {
      var b = e.target.closest('.seg__btn'); if (!b) return;
      toggle.querySelectorAll('.seg__btn').forEach(function (x) {
        x.classList.toggle('is-active', x === b);
        x.setAttribute('aria-pressed', x === b ? 'true' : 'false');
      });
      current = b.dataset.p; draw(current);
    });
    draw(current);
    var rt; window.addEventListener('resize', function () { clearTimeout(rt); rt = setTimeout(function () { draw(current); }, 120); });
  })();
</script>
