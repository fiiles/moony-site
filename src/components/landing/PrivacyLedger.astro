---
import { href, t, type Locale } from '../../i18n';

interface Props { locale: Locale }

const { locale } = Astro.props;
const l = (key: string) => t(locale, `ledger.${key}`);

// Order and wording follow the table "What leaves your computer, and when" in PRIVACY.md (src/content/repo/privacy.md).
const services = ['yahoo', 'coingecko', 'ecb', 'frankfurter', 'github', 'ai'];
const never = ['telemetry', 'data'];
---
<section class="block" id="privacy">
  <div class="wrap">
    <div class="block-head">
      <div class="eyebrow">{l('eyebrow')}</div>
      <h2 class="title">{l('title')}</h2>
      <p>{l('intro')}</p>
    </div>
    <div class="card card--table ledger">
      <div class="table">
        <div class="table__head"><span>{l('head.service')}</span><span>{l('head.sent')}</span><span class="th-when">{l('head.when')}</span><span class="th-off">{l('head.off')}</span></div>
        {services.map((s) => (
          <div class="table__row">
            <b class="svc">{l(`rows.${s}.service`)}</b>
            <span class="sent">{l(`rows.${s}.sent`)}</span>
            <span class="when" data-label={l('head.when')}>{l(`rows.${s}.when`)}</span>
            <span class="how"><span class="badge">{l(`rows.${s}.off`)}</span></span>
          </div>
        ))}
        {never.map((n) => (
          <div class="table__row table__row--never">
            <span class="never">{l(`never.${n}.label`)}</span>
            <span class="never">{l(`never.${n}.value`)}</span>
            <span class="when"></span>
            <span class="how"><span class="badge badge--dark">{l(`never.${n}.badge`)}</span></span>
          </div>
        ))}
      </div>
      <div class="table__foot"><span>{l('foot')}</span><a class="link" href={href('en', 'privacy/')} hreflang={locale === 'cs' ? 'en' : undefined}>{l('footLink')}</a></div>
    </div>
    <div class="note-row">
      <div class="note"><svg class="ic" aria-hidden="true"><use href="#i-lock"/></svg><div><b>{l('encryptedTitle')}</b>{l('encrypted')}</div></div>
      <div class="note"><svg class="ic" aria-hidden="true"><use href="#i-info"/></svg><div><b>{l('plainTitle')}</b>{l('plain')}</div></div>
    </div>
  </div>
</section>
