---
import LanguageLink from '../LanguageLink.astro';
import { href, t, type Locale } from '../../i18n';

interface Props { locale: Locale }

const { locale } = Astro.props;
// Every statement is a short form of a line in PRIVACY.md (src/content/repo/privacy.md).
const cards = [
  { id: 'requests', icon: 'i-info' },
  { id: 'disk', icon: 'i-lock' },
  { id: 'keys', icon: 'i-shield' },
];
---
<section class="block" id="privacy">
  <div class="wrap">
    <div class="block-head">
      <h2 class="title">{t(locale, 'trust.title')}</h2>
    </div>
    <div class="trust">
      {cards.map((c) => (
        <div class="card card--flat trust__card">
          <span class="logo logo--soft" aria-hidden="true"><svg class="ic"><use href={`#${c.icon}`}/></svg></span>
          <h3>{t(locale, `trust.cards.${c.id}.title`)}</h3>
          <p>{t(locale, `trust.cards.${c.id}.text`)}</p>
        </div>
      ))}
    </div>
    <p class="trust__link"><LanguageLink locale={locale} href={href('en', 'privacy/')} hreflang="en">{t(locale, 'trust.link')}</LanguageLink></p>

  </div>
</section>
