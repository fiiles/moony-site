---
import Icons from '../components/Icons.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { alternate, asset, base, defaultLocale, href, locales, localeInfo, siteUrl, t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** Full text of the <title> element. */
  title: string;
  description: string;
  /** Page path without the locale prefix, e.g. "" for the landing page or "download/". */
  path: string;
  /** Social image: an absolute URL, or a path under the site root (e.g. "og/other.png"). */
  ogImage?: string;
  jsonLd?: object;
  /** Keep the page out of search indexes; it then also gives no canonical or hreflang links. */
  noindex?: boolean;
  /** The page exists in English only: no hreflang or og:locale:alternate for other languages, and the language switch leads to their home pages. */
  englishOnly?: boolean;
}

const { locale, title, description, path, ogImage, jsonLd, noindex = false, englishOnly = false } = Astro.props;

const site = siteUrl(Astro.site);
const absolute = (p: string) => new URL(p, site).toString();

const canonical = absolute(href(locale, path));
const alternates = alternate(site, path, englishOnly ? ['en'] : undefined);
const isDefaultImage = !ogImage;
const imageUrl = ogImage ? (/^https?:\/\//.test(ogImage) ? ogImage : absolute(asset(ogImage))) : absolute(asset('og/moony-preview.jpg'));
const { htmlLang, og: ogLocale, latinExt } = localeInfo(locale);
const ogLocaleAlt = locales.filter((l) => l !== locale).map((l) => localeInfo(l).og);
// The Latin-extended subset carries the diacritics of the languages that need it; English pages never request it.
const fontPreloads = latinExt ? ['inter-latin-wght-normal.woff2', 'inter-latin-ext-wght-normal.woff2'] : ['inter-latin-wght-normal.woff2'];
// js/lang.js moves an English page to the visitor's language; only a default-locale page that is indexed and exists in every language may move.
const otherLocales = locales.filter((l) => l !== defaultLocale).join(',');
const autoLanguage = locale === defaultLocale && !englishOnly && !noindex;
// "<" is escaped so the JSON can never close the script element early.
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : undefined;
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* A classic blocking script, ahead of every stylesheet, so a redirect happens before first paint. */}
    <script is:inline src={asset('js/lang.js')} data-locales={otherLocales} data-default={defaultLocale} data-base={base()} data-auto={autoLanguage ? '' : undefined}></script>
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {/* A page kept out of the index (the 404 page) names no canonical address and no language alternates. */}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={asset('favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    {fontPreloads.map((f) => <link rel="preload" as="font" type="font/woff2" href={asset('fonts/' + f)} crossorigin />)}
    <link rel="stylesheet" href={asset('styles/tokens.css')} />
    <link rel="stylesheet" href={asset('styles/site.css')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t(locale, 'site.name')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={imageUrl} />
    {isDefaultImage && <meta property="og:image:width" content="1280" />}
    {isDefaultImage && <meta property="og:image:height" content="640" />}
    <meta property="og:locale" content={ogLocale} />
    {!englishOnly && ogLocaleAlt.map((o) => <meta property="og:locale:alternate" content={o} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {jsonLdText && <script type="application/ld+json" set:html={jsonLdText} />}
  </head>
  <body>
    <Icons />
    <Nav locale={locale} path={path} englishOnly={englishOnly} />
    <main id="top"><slot /></main>
    <Footer locale={locale} />
    <script is:inline src={asset('js/os.js')} defer></script>
  </body>
</html>
