---
import Icons from '../components/Icons.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { alternate, href, t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** Full text of the <title> element. */
  title: string;
  description: string;
  /** Page path without the locale prefix, e.g. "" for the landing page or "download/". */
  path: string;
  /** Social image: an absolute URL, or a path under the site root (e.g. "og/other.png"). */
  ogImage?: string;
  jsonLd?: object;
  noindex?: boolean;
  /** The page has no Czech counterpart: no cs hreflang or og:locale:alternate, and the language switch leads to the Czech home page. */
  englishOnly?: boolean;
}

const { locale, title, description, path, ogImage, jsonLd, noindex = false, englishOnly = false } = Astro.props;

const site = Astro.site ?? new URL('https://moonyapp.com');
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
const asset = (p: string) => base + p;
const absolute = (p: string) => new URL(p, site).toString();

const canonical = absolute(href(locale, path));
const alternates = alternate(Astro.site, path, englishOnly ? ['en'] : undefined);
const isDefaultImage = !ogImage;
const imageUrl = ogImage ? (/^https?:\/\//.test(ogImage) ? ogImage : absolute(asset(ogImage.replace(/^\/+/, '')))) : absolute(asset('og/moony-social-preview.png'));
const ogLocale = locale === 'en' ? 'en_US' : 'cs_CZ';
const ogLocaleAlt = locale === 'en' ? 'cs_CZ' : 'en_US';
// The Latin-extended subset carries the Czech diacritics; English pages never request it, so only preload it for cs.
const fontPreloads = locale === 'cs' ? ['inter-latin-wght-normal.woff2', 'inter-latin-ext-wght-normal.woff2'] : ['inter-latin-wght-normal.woff2'];
// "<" is escaped so the JSON can never close the script element early.
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : undefined;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={asset('favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    {fontPreloads.map((f) => <link rel="preload" as="font" type="font/woff2" href={asset('fonts/' + f)} crossorigin />)}
    <link rel="stylesheet" href={asset('styles/tokens.css')} />
    <link rel="stylesheet" href={asset('styles/site.css')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t(locale, 'site.name')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    {isDefaultImage && <meta property="og:image:width" content="1280" />}
    {isDefaultImage && <meta property="og:image:height" content="640" />}
    <meta property="og:locale" content={ogLocale} />
    {!englishOnly && <meta property="og:locale:alternate" content={ogLocaleAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {jsonLdText && <script type="application/ld+json" set:html={jsonLdText} />}
  </head>
  <body>
    <Icons />
    <Nav locale={locale} path={path} englishOnly={englishOnly} />
    <main id="top"><slot /></main>
    <Footer locale={locale} />
  </body>
</html>
