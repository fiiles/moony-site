---
import Base from '../../layouts/Base.astro';
import HelpPage from '../../components/HelpPage.astro';
import { localizedPaths, t } from '../../i18n';
export const getStaticPaths = localizedPaths;
const { locale } = Astro.params;
---
<Base locale={locale} title={t(locale, 'help.metaTitle')} description={t(locale, 'help.description')} path="help/">
  <HelpPage locale={locale} />
</Base>
