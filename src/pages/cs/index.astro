---
import Base from '../../layouts/Base.astro';
import { t } from '../../i18n';

const locale = 'cs';
---
<Base locale={locale} title={`${t(locale, 'site.name')} — ${t(locale, 'site.tagline')}`} description={t(locale, 'site.description')} path="">
  <section class="hero-section">
    <div class="wrap hero-copy">
      <h1>{t(locale, 'site.tagline')}</h1>
    </div>
  </section>
</Base>
