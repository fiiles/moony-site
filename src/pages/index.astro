---
import Base from '../layouts/Base.astro';
import Landing from '../components/Landing.astro';
import { t } from '../i18n';

const locale = 'en';
---
<Base locale={locale} title={`${t(locale, 'site.name')} — ${t(locale, 'site.tagline')}`} description={t(locale, 'site.description')} path="">
  <Landing locale={locale} />
</Base>
